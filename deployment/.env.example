# Vorlage für Z:\siloplanenrace\.env (NAS-Deployment).
# Diese Datei zu ".env" kopieren/umbenennen und die Werte durch echte
# Zufallswerte ersetzen. Die echte .env liegt NUR auf dem NAS, NICHT im
# Git-Repo (siehe .gitignore).

# Datenbank-Passwort (mindestens 20 Zeichen, zufällig)
DB_PASSWORD=bitte-aendern

# Flask Secret Key (mindestens 32 Zeichen, zufällig)
SECRET_KEY=bitte-aendern

# Startpasswort des automatisch angelegten Administrators "admin".
# Nach dem ersten Login unbedingt in der App ändern.
ADMIN_STARTPASSWORT=bitte-aendern

# Zufallswerte erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
